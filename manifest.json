      "image": "assets/az-manager.png",
      "accent": "#f6a400",
      "installerUrl": "https://github.com/YOUR-GITHUB/AZ-Manager/releases/latest/download/AZ-Manager-Setup.exe",
      "installerFileName": "AZ-Manager-Setup.exe",
      "installerType": "exe",
      "releaseNotes": "Starter launcher with Firebase login, GitHub manifest support, download progress and install checking.",
      "requiredTier": "free",
      "homepageUrl": "https://github.com/YOUR-GITHUB/AZ-Manager",
      "installCheck": {
        "paths": [
          "%LocalAppData%\\Programs\\AZ Manager\\AZ Manager.exe",
          "%ProgramFiles%\\AZ\\AZ Manager\\AZ Manager.exe",
          "%AppData%\\AZ\\Manager\\AZ Manager.exe"
        ]
      }
    },
